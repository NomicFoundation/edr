{
  "extends": "@tsconfig/node22/tsconfig.json",
  "compilerOptions": {
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmitOnError": true,
    "skipDefaultLibCheck": true,
    "types": ["node", "mocha"],
    "outDir": "./dist",
    "composite": true
  },
  "include": ["./*.ts", "./test/**/*.ts", "./src/ts/**/*.ts"],
  "exclude": ["./node_modules"]
}
